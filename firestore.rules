rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsBusiness(businessId) {
      return signedIn()
        && businessId == request.auth.uid
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }

    match /businesses/{businessId} {
      allow create: if signedIn()
        && businessId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if signedIn()
        && businessId == request.auth.uid
        && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && businessId == request.auth.uid
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      match /{collection}/{documentId} {
        allow read, delete: if ownsBusiness(businessId);
        allow create, update: if ownsBusiness(businessId)
          && request.resource.data.businessId == businessId;
      }
    }
  }
}
