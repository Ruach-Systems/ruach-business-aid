@inject BusinessState Store
@inject NavigationManager Navigation
@implements IDisposable
@if (!Store.Ready)
{
<div class="app-loading" role="status">
<BrandLogo Reversed="true" Large="true" />
<span>Opening your business…</span>
</div>
}
else if (Store.StartupError)
{
<div class="app-loading">
<h1>Could not open your business</h1>
<p>@Store.Error</p>
<button class="button primary" @onclick="Store.Initialize">Try again</button>
</div>
}
else
{
<Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
<RouteView @key="Store.Data.Business?.Id" RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
<FocusOnNavigate RouteData="@routeData" Selector="h1" />
</Found>
        <NotFound>
<LayoutView Layout="@typeof(MainLayout)">
<div class="page">
<h1>Page not found</h1>
<a class="button primary" href="/dashboard">Go to dashboard</a>
</div>
</LayoutView>
</NotFound>
    </Router>
}
@code {
    protected override async Task OnInitializedAsync() { Store.Changed += Changed; Navigation.LocationChanged += Navigated; await Store.Initialize(); Redirect(); }
    private void Changed() { _ = InvokeAsync(() => { Redirect(); StateHasChanged(); }); }
    private void Navigated(object? sender, LocationChangedEventArgs args) => Redirect();
    private void Redirect()
    {
        if (Store.StartupError) return;
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];
        var newOwner = Store.Account is { Businesses.Count: 0, Requests.Count: 0 };
        var route = Store.User?.IsDemo == true
            ? Calculations.Route(Store.Ready, true, Store.Data.Business is not null, path)
            : Calculations.AccountRoute(Store.Ready, Store.User is not null, Store.Data.Business is not null, Store.PhoneRequired, Store.User?.IsAdmin == true, newOwner, path);
        if (route != path) Navigation.NavigateTo(route, replace: true);
    }
    public void Dispose() { Store.Changed -= Changed; Navigation.LocationChanged -= Navigated; }
}
