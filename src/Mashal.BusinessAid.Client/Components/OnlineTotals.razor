@inherits PageBase
@inject ApiClient Api
<section class="section">
<div class="section-heading reports-heading">
<h2>Summary</h2>
<a href="/reports">View reports</a>
</div>
<p class="reports-subtitle">Weekly and monthly sales, expenses, and estimated profit.</p>
@if (!Store.Online || Store.User?.IsDemo == true) {
<div class="card">
<p class="metric-note">Connect and sign in to view synchronized weekly and monthly totals.</p>
</div> }
else
{
@if (Store.PendingCount > 0) {
<p class="field-help">@Store.PendingCount pending changes are not included until synchronization finishes.</p> }
<ErrorBanner Message="@Error" />
<div class="period-grid">@foreach (var period in new[] { "week", "month" })
{
<article class="card">
<span class="card-label">@(period == "week" ? "This week" : "This month")</span>
    @if (totals.TryGetValue(period, out var total)) {
<div class="period-total">
<span>Sales</span>
<strong>@Money(total.RevenueCentavos)</strong>
</div>
<div class="period-total">
<span>Expenses</span>
<strong>@Money(total.ExpenseCentavos)</strong>
</div>
<div class="period-total">
<span>Estimated profit</span>
<strong>@Money(total.ProfitCentavos)</strong>
</div> } else {
<p class="metric-note">Loading synchronized totals…</p> }
</article>
}
</div>
<p class="field-help">Operational estimates from synchronized records.</p>
}
</section>
@code {
    private Dictionary<string, FinancialSummary> totals = [];
    protected override async Task OnInitializedAsync() { Store.Changed += Refresh; await Load(); }
    private string signature = "";
    private void Refresh() { var current = $"{Store.Online}-{Store.PendingCount}-{Store.Busy}-{Store.Data.Business?.Id}"; if (signature != current) { signature = current; _ = InvokeAsync(Load); } }
    private async Task Load()
    {
        if (!Store.Online || Store.User?.IsDemo == true || Store.Data.Business is null) { totals.Clear(); StateHasChanged(); return; }
        try { foreach (var period in new[] { "week", "month" }) { var range = Period(period); totals[period] = await Api.Report<FinancialSummary>("summary", Store.Data.Business.Id, range.From, range.To); } Error = ""; }
        catch (Exception e) { totals.Clear(); Error = e.Message; }
        StateHasChanged();
    }
    public override void Dispose() { Store.Changed -= Refresh; base.Dispose(); }
}
<style>.period-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.period-total{display:flex;justify-content:space-between;gap:12px;padding:10px 0;font-size:13px}.period-total strong{overflow-wrap:anywhere;text-align:right}@@media(max-width:420px){.period-grid{grid-template-columns:1fr}}
</style>
