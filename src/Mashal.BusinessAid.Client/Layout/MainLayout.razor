@inherits LayoutComponentBase
@inject BusinessState Store
<div class="app-shell">
    <aside class="side-nav">
        <a class="side-brand" href="/dashboard">
<BrandLogo Reversed="true" />
<span class="product-label">Business Aid</span>
<small>@Store.Data.Business?.Name</small>
</a>
        <nav aria-label="Main navigation">@foreach (var item in links) {
<NavLink href="@item.Path">
<Icon Name="@item.Icon" />@item.Label</NavLink> }
</nav>
        @if (Store.User?.IsDemo != true) { <a class="button workspace-switch" href="/businesses">Switch business</a> }
        <SyncPill />
    </aside>
    <main class="main-panel">
        <header class="mobile-header">
<a href="/dashboard" class="mobile-brand">
<BrandLogo Reversed="true" />
<span>Business Aid</span>
</a>
<SyncPill />
</header>
        <div class="workspace-context"><strong>@Store.Data.Business?.Name</strong><span>Separate business workspace</span>@if (Store.User?.IsDemo != true) { <a href="/businesses">Switch business</a> }</div>
        <SyncReview />
        @Body
    </main>
    <nav class="bottom-nav" aria-label="Mobile navigation">
        <NavLink href="/dashboard">
<Icon Name="home" />
<span>Home</span>
</NavLink>
<NavLink href="/sales">
<Icon Name="cart" />
<span>Sales</span>
</NavLink>
<NavLink href="/items">
<Icon Name="cube" />
<span>Items</span>
</NavLink>
<NavLink href="/more">
<Icon Name="more" />
<span>More</span>
</NavLink>
    </nav>
</div>
@code {
    private readonly (string Path, string Label, string Icon)[] links = [("/dashboard", "Overview", "home"), ("/sales", "Daily sales", "cart"), ("/items", "Items", "tag"), ("/expenses", "Expenses", "wallet"), ("/reports", "Reports", "chart"), ("/settings", "Settings", "settings")];
}
