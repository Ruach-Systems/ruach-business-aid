@namespace Mashal.BusinessAid.Client.Pages
@page "/items/{Id:guid}"
@inherits PageBase
<div class="page narrow">
<BackLink To="/items" Text="Back to items" />
@if(Item is {} item){
<PageHeading Title="@item.Name" Eyebrow="Price, cost & stock" Description="One place to manage this item."><a class="button ghost small" href="@($"/items/{Id}/edit")">Edit item</a></PageHeading>
@if(!item.IsActive){<div class="notice">This item is inactive and will not appear when recording sales.</div>}
@if(item.CurrentQuantity<0){<div class="notice warning" role="alert">Stock is negative by @Quantity(-item.CurrentQuantity). Add or correct stock when ready.</div>}
<div class="metric-grid">
<article class="card dark"><span class="card-label">Current stock</span><div class="metric-value">@Quantity(item.CurrentQuantity)</div><span>whole items</span></article>
<article class="card"><span class="card-label">Selling price</span><div class="metric-value">@Money(item.SellingPriceCentavos)</div></article>
<article class="card"><span class="card-label">Unit cost</span><div class="metric-value">@Money(item.UnitCostCentavos)</div></article>
<article class="card"><span class="card-label">Profit per item</span><div class="metric-value">@Money(UnitProfit(item.SellingPriceCentavos,item.UnitCostCentavos))</div><small>@MarkupText(item.SellingPriceCentavos,item.UnitCostCentavos)</small></article>
</div>
<div class="quick-actions section"><a class="button primary" href="@($"/stock/add?item={Id}")">Add stock</a><a class="button ghost" href="@($"/stock/adjust?item={Id}")">Correct stock</a></div>
<section class="section"><div class="section-heading"><h2>Stock history</h2></div><div class="stack">
@foreach(var movement in Store.Data.Movements.Where(x=>x.ItemId==Id && x.DeletedAt is null).OrderByDescending(x=>x.CreatedAt)){
<article class="card list-card"><div class="list-main"><strong>@movement.MovementType.Replace('_',' ')</strong><small>@movement.CreatedAt.ToLocalTime().ToString("MMM d, yyyy HH:mm") · @movement.Note</small></div><div><strong>@(movement.QuantityDelta>0?"+":"")@Quantity(movement.QuantityDelta)</strong><small>Balance @Quantity(movement.BalanceAfter)</small></div></article>}
@if(!Store.Data.Movements.Any(x=>x.ItemId==Id)){<div class="card empty"><p>No stock movements yet.</p></div>}
</div></section>}
else{<h1>Item not found</h1>}
</div>
