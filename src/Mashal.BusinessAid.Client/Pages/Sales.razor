@page "/sales"
@inherits PageBase
<div class="page narrow">
<PageHeading Title="What sold today?" Eyebrow="Fast daily entry" Description="Enter totals by product—no checkout screen required." />
<form class="stack" @onsubmit="Save" @onsubmit:preventDefault>
<section class="card form-card">
<div class="field">
<label for="sale-date">Sale date</label>
<input id="sale-date" type="date" max="@Today().ToString("yyyy-MM-dd")" @bind="date" required />
</div>
</section>
<section class="stack sale-lines">@foreach(var product in Store.Products){Ensure(product.Id);<article class="card sale-line">
<div class="list-main">
<strong>@product.Name</strong>
<div class="unit-pricing">
<span>Price <b>@Money(product.SellingPriceCentavos)</b> / item</span>
<span>Cost <b>@Money(ProductCost(product,Store.Inventory))</b> / item</span>
</div>
</div>
<div class="stepper">
<button type="button" aria-label="@($"Decrease {product.Name} quantity")" @onclick="()=>Change(product.Id,-1)">−</button>
<input type="number" min="0" step="1" inputmode="numeric" aria-label="@($"{product.Name} quantity sold")" @bind="quantities[product.Id]" @bind:event="oninput" />
<button type="button" aria-label="@($"Increase {product.Name} quantity")" @onclick="()=>Change(product.Id,1)">+</button>
</div>
</article>}
</section>
@if(!Store.Products.Any()){
<div class="card empty">
<h3>Add products first</h3>
<p>Products appear here for quick daily quantity entry.</p>
<a class="button primary" href="/products/new">Add product</a>
</div>}
<section class="card dark totals-card" aria-label="Sale totals" aria-live="polite">
<div>
<span class="card-label">Items</span>
<strong>@Quantity(quantities.Values.Sum())</strong>
</div>
<div>
<span class="card-label">Sales</span>
<strong>@Money(Revenue)</strong>
</div>
<div>
<span class="card-label">Product cost</span>
<strong>@Money(Cost)</strong>
</div>
<div>
<span class="card-label">Estimated profit</span>
<strong>@Money(Revenue-Cost)</strong>
</div>
</section>
<label class="toggle-row">
<span>
<strong>Deduct inventory</strong>
<small>Uses each product’s finished stock mode.</small>
</span>
<input type="checkbox" class="toggle" @bind="deduct" />
</label>
@if(message!=""){
<div class="success-banner" role="status">@message</div>}<ErrorBanner Message="@Error" />
<button class="button primary block" disabled="@(Saving || quantities.Values.Sum()==0)">Save @Quantity(quantities.Values.Sum()) items</button>
</form>
<section id="sales-history" class="section sales-history">
<div class="section-heading">
<h2>Sales history</h2>
</div>
@if (Store.Sales.Any()) {
<div class="stack">@foreach (var sale in Store.Sales.OrderByDescending(x => x.CreatedAt)) {
<article class="card list-card">
<span class="list-icon"><Icon Name="cart" /></span>
<div class="list-main">
<strong>@Quantity(sale.TotalItems) items</strong>
<small>@FriendlyDate(sale.SaleDate, Today()) · @string.Join(", ", sale.Lines.Select(x => x.ProductName))</small>
</div>
<strong class="sale-amount">@Money(sale.TotalRevenueCentavos)</strong>
</article>}
</div>
} else {
<div class="card empty"><p>No sales recorded yet.</p></div>
}
</section>
</div>
