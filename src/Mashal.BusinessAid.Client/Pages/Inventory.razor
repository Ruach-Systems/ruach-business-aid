@page "/inventory"
@inherits PageBase
<div class="page">
<PageHeading Title="Inventory" Eyebrow="Ingredients & finished stock" Description="Every balance is backed by a movement.">
<a class="button primary small" href="/inventory/new">
<Icon Name="plus" />Add item</a>
</PageHeading>
<div class="inventory-toolbar card">
<div class="search-box">
<label class="sr-only" for="inventory-search">Search inventory</label>
<input id="inventory-search" type="search" placeholder="Search inventory" @bind="search" @bind:event="oninput" />
</div>
<div class="inventory-actions">
<a class="button dark small" href="/stock/add">Add stock</a>
<a class="button ghost small" href="/stock/adjust">Adjust</a>
</div>
</div>
@if(Items.Any()){
<div class="inventory-grid section">@foreach(var item in Items){
<a class="card list-card inventory-card" href="@($"/inventory/{item.Id}")">
<span class="list-icon">
<Icon Name="cube" />
</span>
<span class="list-main">
<span class="item-title">
<strong>@item.Name</strong>
@if(item.CurrentQuantity<=item.MinimumQuantity){
<span class="pill warning">Low</span>}
</span>
<small>Avg. @Money(item.AverageCostCentavos) per @UnitName(item.BaseUnit, 1)</small>
</span>
<span class="quantity">
<strong>@Quantity(item.CurrentQuantity)</strong>
<small>@UnitName(item.BaseUnit, item.CurrentQuantity)</small>
</span>
<span class="chevron">›</span>
</a>}
</div>}
else{
<div class="card empty section">
<span class="list-icon">
<Icon Name="cube" />
</span>
<h3>@(search.Length>0?"No matching items":"No inventory items yet")</h3>
<p>Create raw ingredients, packaging, or finished products to start tracking stock.</p>
@if(search.Length==0){
<a class="button primary small" href="/inventory/new">Add first item</a>}
</div>}
</div>
