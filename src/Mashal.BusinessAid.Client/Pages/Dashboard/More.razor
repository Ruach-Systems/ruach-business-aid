@namespace Mashal.BusinessAid.Client.Pages
@page "/more"
<div class="page">
<PageHeading Title="More" Eyebrow="Your business toolkit" Description="Everything else you need to keep business moving." />
<div class="stack">
@foreach(var item in links){
<a class="card list-card" href="@item.Path">
<span class="list-icon">
<Icon Name="@item.Icon" />
</span>
<div class="list-main">
<strong>@item.Label</strong>
</div>
<Icon Name="chevron-right" />
</a>}
</div>
</div>
