@page "/production/new"
@page "/production/{Id:guid}"
@inherits PageBase
<div class="page narrow">
<BackLink To="/production" Text="Back to production" />
<PageHeading Title="@(selecting?"Select a product":existing?.Status=="completed"?"Completed batch":Id is null?"Plan the batch":$"{Product?.Name} plan")" Eyebrow="@(selecting?"Step 1 of 2":Id is null?"Step 2 of 2":"Batch record")" Description="@(selecting?"Only prepared-in-advance products appear here.":"Nothing is deducted until you complete the batch.")" />
@if(selecting){
<div class="stack">
@foreach(var p in Store.Products.Where(x=>x.InventoryMode=="prepared")){
<button class="card product-choice @(productId==p.Id?"selected":"")" type="button" role="radio" aria-checked="@(productId==p.Id ? "true" : "false")" @onclick="()=>productId=p.Id">
<span class="list-icon">
<Icon Name="batch" />
</span>
<span class="list-main">
<strong>@p.Name</strong>
<small>@p.Recipe.Count recipe ingredients</small>
</span>
</button>}
@if(!Store.Products.Any(x=>x.InventoryMode=="prepared")){
<div class="card empty">
<h3>No prepared products</h3>
<p>Create a product with the “Prepared in advance” inventory mode first.</p>
<a class="button primary" href="/products/new">Create product</a>
</div>}
else{
<button class="button primary block" disabled="@(productId==Guid.Empty)" @onclick="()=>selecting=false">Continue to batch details</button>}
</div>}
else if(existing?.Status=="completed"){
<div class="card stack">
<h2>@existing.ProductName</h2>
<span class="pill success">Completed</span>
<p>Actual yield: @Quantity(existing.ActualYield??0)</p>
<p>Batch cost: @Money(existing.TotalCostCentavos??0) · Cost per item: @Money(existing.CostPerUnitCentavos??0)</p>
<p>Completion is final. Use a stock adjustment for physical corrections.</p>
</div>}
else{
<form class="stack" @onsubmit="Save" @onsubmit:preventDefault>
<section class="card form-card">
<div class="field">
<label for="batch-product">Product</label>
<input id="batch-product" value="@Product?.Name" disabled />
</div>
<div class="field">
<label for="planned-yield">Planned yield</label>
<input id="planned-yield" type="number" min="1" step="1" @bind:get="decimal.Round(yield, 2)" @bind:set="value => yield = value" required @bind:event="oninput" />
</div>
<div class="field">
<label for="batch-note">Batch note (optional)</label>
<textarea id="batch-note" @bind="note">
</textarea>
</div>
</section>
<section class="card">
<div class="section-heading">
<div>
<span class="card-label">Live recipe calculation</span>
<h2>Required ingredients</h2>
</div>
</div>
<div class="requirement-list">@foreach(var line in Product?.Recipe??[]){var item=Store.Inventory.FirstOrDefault(x=>x.Id==line.InventoryItemId);<div class="requirement">
<div>
<strong>@item?.Name</strong>
<small>Needed: @Quantity(line.Quantity*yield) @UnitName(item?.BaseUnit, line.Quantity*yield)</small>
<small>Available: @Quantity(item?.CurrentQuantity??0) @UnitName(item?.BaseUnit, item?.CurrentQuantity??0)</small>
</div>
<span class="requirement-cost"><small>Estimated cost</small>@Money(Rules.Round(line.Quantity*yield*(item?.AverageCostCentavos??0)))</span>
</div>}
</div>
</section>
<section class="card soft rule-note">
<strong>Drafts do not change inventory</strong>
<span>Ingredient quantities are deducted and finished stock is added only after actual production is recorded.</span>
</section>
<ErrorBanner Message="@Error" />
<div class="form-actions">@if(Id is null){
<button type="button" class="button ghost" @onclick="()=>selecting=true">Back to product selection</button>}else{
<a class="button ghost" href="/production">Cancel</a>}<button class="button @(Id is null ? "dark" : "ghost")" disabled="@(Saving || Product?.Recipe.Count is null or 0)">Save draft</button>
</div>
@if(Id is not null){
<a class="button dark block" href="@($"/production/{Id}/complete")">Record actuals & complete</a>}
</form>}
</div>
