@page "/production"
@inherits PageBase
<div class="page">
<PageHeading Title="Production" Eyebrow="Prepared-in-advance products" Description="Plan a batch, review actual use, then post it to inventory.">
<a class="button primary small" href="/production/new">Make batch</a>
</PageHeading>
@if(!Prepared.Any()){
<div class="card soft setup-callout">
<span class="list-icon">
<Icon Name="batch" />
</span>
<div>
<strong>Create a prepared product first</strong>
<p>Set a product to “Prepared in advance” and add its recipe. MASHAL will create finished stock from completed batches.</p>
</div>
<a class="button dark small" href="/products/new">Add product</a>
</div>}
<div class="split section">
<section>
<div class="section-heading">
<h2>Draft batches</h2>
<span class="pill">@Drafts.Count() drafts</span>
</div>
@if(Drafts.Any()){
<div class="stack">@foreach(var batch in Drafts){
<a class="card batch-card" href="@($"/production/{batch.Id}")">
<div class="batch-icon">
<Icon Name="batch" />
</div>
<div class="list-main">
<span class="pill">Draft</span>
<h3>@batch.ProductName</h3>
<small>Planned @Quantity(batch.PlannedYield) items · @batch.Ingredients.Count ingredients</small>
</div>
<span class="batch-chevron"><Icon Name="chevron-right" /></span>
</a>}
</div>}
else{
<div class="card empty">
<h3>No draft batches</h3>
<p>Start a production plan. Inventory remains untouched until completion.</p>
@if(Prepared.Any()){
<a class="button primary small" href="/production/new">Make a batch</a>}
</div>}
</section>
<section>
<div class="section-heading">
<h2>Finished stock</h2>
</div>
@if(Prepared.Any()){
<div class="stack">@foreach(var product in Prepared){var item=Store.Inventory.FirstOrDefault(x=>x.Id==product.FinishedInventoryItemId);<article class="card finished-stock-card">
<div class="finished-stock-heading">
<span class="list-icon">
<Icon Name="cube" />
</span>
<h3>@product.Name</h3>
</div>
<dl class="finished-stock-metrics">
<div class="finished-stock-quantity">
<dt>Available to sell</dt>
<dd>@Quantity(item?.CurrentQuantity??0) <span>items</span></dd>
</div>
<div>
<dt>Average cost</dt>
<dd>@Money(item?.AverageCostCentavos??0)</dd>
<span class="finished-stock-unit">per item</span>
</div>
</dl>
</article>}
</div>}else{
<div class="card empty compact">
<p>No finished-stock products.</p>
</div>}
</section>
</div>
@if(Completed.Any()){
<section class="section">
<div class="section-heading">
<h2>Recently completed</h2>
</div>
<div class="completed-grid">@foreach(var batch in Completed){
<article class="card completed-card">
<Icon Name="batch" />
<div>
<strong>@batch.ProductName</strong>
<small>@Quantity(batch.ActualYield??0) items · @Money(batch.TotalCostCentavos??0) total</small>
</div>
<span>@((batch.CompletedAt??batch.UpdatedAt).ToString("MMM d, yyyy"))</span>
</article>}
</div>
</section>}
</div>
