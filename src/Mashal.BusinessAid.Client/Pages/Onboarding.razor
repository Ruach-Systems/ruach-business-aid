@page "/onboarding"
@layout EmptyLayout
@inherits PageBase
<PageTitle>Create business | Mashal Business Aid</PageTitle>
<main class="onboarding-page">
<section class="onboarding-card">
<BrandLogo />
<span class="eyebrow">First things first</span>
<h1>Create your business</h1>
<p>One account can manage one business. You can change these details later.</p>
<div class="account-summary">
<span>Signed in as</span>
<strong>@Store.User?.Email</strong>
</div>
<form class="form-card" @onsubmit="Submit" @onsubmit:preventDefault>
<div class="field">
<label for="business-name">Business name</label>
<input id="business-name" @bind="name" required placeholder="e.g. Aling Nena's Kakanin" />
</div>
<div class="field">
<label for="business-location">Default location</label>
<input id="business-location" @bind="location" required />
</div>
<div class="info-panel">
<strong>Philippine peso · Asia/Manila</strong>
<span>Your reporting day and currency are already configured.</span>
</div>
<label class="toggle-row">
<span>
<strong>Add sample products</strong>
<small>Buko Juice, Empanada, and Siomai</small>
</span>
<input class="toggle" type="checkbox" @bind="samples" />
</label>
<ErrorBanner Message="@Error" />
<button class="button primary block" disabled="@Saving">@(Saving ? "Creating…" : "Create business")</button>
</form>
<div class="account-actions">
<button class="button ghost block" disabled="@Saving" @onclick="() => Run(Store.Logout)">Cancel and use a different account</button>
</div>
@if (Store.ShowReset) {
<button class="button ghost block" @onclick="() => Run(Store.Logout)">Reset sign-in state</button> }
</section>
</main>
