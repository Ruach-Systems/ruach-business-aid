@page "/settings"
@inherits PageBase
<div class="page narrow">
<PageHeading Title="Settings" Eyebrow="Preferences & safety" Description="Manage your account, business details, and cloud sync." />
<section class="card profile-card">
<div>
<strong>@Store.User?.DisplayName</strong>
<span>@Store.User?.Email</span>
<small>Owner · one account, one business</small>
</div>
</section>
<section class="section stack">
<article class="card">
<div class="section-heading">
<h2>Cloud sync</h2>
<SyncPill />
</div>
<p>@Store.PendingCount changes waiting to synchronize. Saved device records remain available offline.</p>
<button class="button ghost block" @onclick="Store.Synchronize">Sync now</button>
</article>
<article class="card">
<div class="section-heading">
<h2>Business</h2>
</div>
<dl>
<div>
<dt>Name</dt>
<dd>@Store.Data.Business?.Name</dd>
</div>
<div>
<dt>Location</dt>
<dd>@Store.Data.Business?.DefaultLocation</dd>
</div>
<div>
<dt>Currency</dt>
<dd>Philippine peso (PHP)</dd>
</div>
<div>
<dt>Timezone</dt>
<dd>Asia/Manila</dd>
</div>
</dl>
</article>
@if(Store.CanResetLocalData){
<article class="card reset-card">
<span class="card-label">Local development</span>
<div class="section-heading compact">
<h2>Fresh start</h2>
</div>
<p>Clear this local demo workspace and return to business setup. This does not affect server accounts or SQL data.</p>
@if(confirmingReset){
<div class="reset-confirmation" role="alert" aria-live="assertive">
<strong>Delete all local demo data?</strong>
<span>Products, inventory, sales, expenses, production batches, and pending changes on this device will be permanently removed.</span>
<div>
<button type="button" class="button ghost" disabled="@Saving" @onclick="()=>confirmingReset=false">Keep my data</button>
<button type="button" class="button primary" disabled="@Saving" @onclick="ResetLocalData">Delete and start over</button>
</div>
</div>}
else{
<button type="button" class="button danger block" disabled="@Saving" @onclick="()=>confirmingReset=true">Reset local data</button>}
</article>}
<ErrorBanner Message="@Error" />
<button class="button danger block" @onclick="()=>Run(Store.Logout)">Sign out</button>
</section>
</div>

@code {
    private bool confirmingReset;
    private Task ResetLocalData() => Run(Store.ResetLocalData, "/onboarding");
}
