@page "/"
@page "/dashboard"
@inherits PageBase
<div class="page">
<PageHeading Title="Business overview" Eyebrow="Today at a glance" Description="@($"{Store.Data.Business?.Name} · {Store.Data.Business?.DefaultLocation}")">
<span class="date-chip">@Today().ToString("dddd, MMMM d")</span>
</PageHeading>
<section class="today-summary" aria-label="Today's performance">
<article class="card dark profit-card">
<span class="card-label">Today's estimated profit · this device</span>
<div class="metric-value">@Money(Revenue - Cost - ExpenseTotal)</div>
<span class="metric-note">What’s left from today’s sales after the cost of items sold and business expenses.</span>
<div class="profit-decoration" aria-hidden="true">
</div>
</article>
<article class="card today-breakdown">
<div class="today-breakdown-heading">
<span class="card-label">Today's activity</span>
<span class="item-count">@TodaySales.Sum(x => x.TotalItems) items sold</span>
</div>
<div class="today-total">
<span>Sales</span>
<strong>@Money(Revenue)</strong>
</div>
<div class="today-total">
<span>Product cost</span>
<strong>@Money(Cost)</strong>
</div>
<div class="today-total">
<span>Expenses</span>
<strong>@Money(ExpenseTotal)</strong>
</div>
<details class="activity-details">
<summary>View today's breakdown</summary>
<p class="metric-note">Based on records saved on this device, including changes waiting to synchronize. Profit is an operational estimate.</p>
<h3>Sales by product</h3>
@foreach(var group in TodaySales.SelectMany(x=>x.Lines).GroupBy(x=>new { x.ProductId, x.ProductName })){
<div class="activity-entry">
<strong>@group.Key.ProductName</strong>
<small>@Quantity(group.Sum(x=>x.Quantity)) items sold</small>
<dl>
<div><dt>Sales</dt><dd>@Money(group.Sum(x=>x.LineRevenueCentavos))</dd></div>
<div><dt>Product cost</dt><dd>@Money(group.Sum(x=>x.LineCostCentavos))</dd></div>
<div><dt>Gross profit</dt><dd>@Money(group.Sum(x=>x.LineRevenueCentavos-x.LineCostCentavos))</dd></div>
</dl>
</div>}
@if(!TodaySales.Any()){<p class="metric-note">No sales recorded today.</p>}
<h3>Expenses</h3>
@foreach(var expense in TodayExpenses.OrderByDescending(x=>x.CreatedAt)){
<div class="activity-entry expense-entry">
<div><strong>@expense.Description</strong><small>@expense.Category</small></div>
<strong>@Money(expense.AmountCentavos)</strong>
</div>}
@if(!TodayExpenses.Any()){<p class="metric-note">No expenses recorded today.</p>}
<dl class="activity-reconciliation">
<div><dt>Total sales</dt><dd>@Money(Revenue)</dd></div>
<div><dt>Less product cost</dt><dd>@Money(Cost)</dd></div>
<div><dt>Less expenses</dt><dd>@Money(ExpenseTotal)</dd></div>
<div><dt>Estimated net profit</dt><dd>@Money(Revenue-Cost-ExpenseTotal)</dd></div>
</dl>
</details>
</article>
</section>
<section class="section">
<div class="section-heading">
<h2>Quick actions</h2>
</div>
<div class="quick-actions">
<a class="button primary" href="/sales">
<Icon Name="cart" />Record sale</a>
<a class="button ghost" href="/production/new">
<Icon Name="batch" />Make batch</a>
<a class="button ghost" href="/stock/add">
<Icon Name="cube" />Add stock</a>
<a class="button ghost" href="/expenses">
<Icon Name="wallet" />Add expense</a>
</div>
</section>
<OnlineTotals />
<div class="split section">
<section>
<div class="section-heading">
<h2>Recent sales</h2>
<a href="/sales#sales-history">View all</a>
</div>
@if (Store.Sales.Any()) {
<div class="stack">@foreach (var sale in Store.Sales.OrderByDescending(x => x.CreatedAt).Take(4)) {
<article class="card list-card">
<span class="list-icon">
<Icon Name="cart" />
</span>
<div class="list-main">
<strong>@Quantity(sale.TotalItems) items · @sale.Location</strong>
<small>@FriendlyDate(sale.SaleDate, Today()) · @string.Join(", ", sale.Lines.Select(x => x.ProductName))</small>
</div>
<strong class="sale-amount">@Money(sale.TotalRevenueCentavos)</strong>
</article> }
</div> }
else {
<div class="card empty">
<h3>No sales recorded yet</h3>
<p>Record your first sale and MASHAL will calculate revenue, cost, and profit.</p>
<a class="button primary small" href="/sales">Record first sale</a>
</div> }
</section>
<section>
<div class="section-heading">
<h2>Low stock</h2>
<a href="/inventory">View all</a>
</div>
@if (LowStock.Any()) {
<div class="card warning stack">@foreach (var item in LowStock.Take(5)) {
<a href="@($"/inventory/{item.Id}")" class="list-card compact">
<div class="list-main">
<strong>@item.Name</strong>
<small>@Quantity(item.CurrentQuantity) @UnitName(item.BaseUnit, item.CurrentQuantity) remaining</small>
</div>
</a> }
</div> }
else if (Store.Inventory.Any()) {
<div class="card success">
<span class="card-label">Inventory health</span>
<h3 class="healthy">Everything looks stocked</h3>
<p class="metric-note">No items are at or below their minimum.</p>
</div> }
else {
<div class="card empty">
<h3>No inventory to monitor</h3>
<p>Add an inventory item to start tracking stock levels.</p>
<a class="button ghost small" href="/inventory/new">Add inventory item</a>
</div> }
</section>
</div>
</div>
