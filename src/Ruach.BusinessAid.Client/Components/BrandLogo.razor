<span class="@CssClass" role="img" aria-label="Business Aid by RUACH"><img class="brand-mark" src="/brand-assets/favicon.1571b65291d087a0.svg" alt="" width="36" height="36" /><span class="brand-name"><strong>Business Aid</strong><span class="brand-endorsement">by RUACH</span></span></span>
@code {
    // Emblem with live text: outlined wordmark lettering blurs at small sizes on phones.
    [Parameter] public bool Reversed { get; set; }
    [Parameter] public bool Large { get; set; }
    private string CssClass => "brand-compact" + (Reversed ? " reversed" : "") + (Large ? " large" : "");
}