@namespace Ruach.BusinessAid.Client.Pages
@page "/reports"
@inherits PageBase
@inject ApiClient Api
<div class="page reports-page">
<PageHeading Title="Reports" Eyebrow="Business performance" Description="See revenue, item cost, gross profit, expenses, and net profit." />
@if(!Store.Online && Store.User?.IsDemo!=true){<section class="card empty"><h2>Reports require an online account</h2><p>Connect and synchronize your records to view financial reports.</p></section>}
else{
@if(Store.User?.IsDemo==true){<p class="notice">Local preview · Calculated from sales and expenses saved on this device.</p>}
<section class="card report-filters @(CustomRange?"custom":"")" aria-label="Report filters">
<div class="field"><label for="report-period">Period</label><select id="report-period" @bind="period" @bind:after="ChangePeriod"><option value="today">Today</option><option value="week">This week</option><option value="month">This month</option><option value="custom">Custom range</option></select></div>
@if(CustomRange){
<div class="field"><label for="report-from">From</label><input id="report-from" type="date" min="2026-01-01" max="@to.ToString("yyyy-MM-dd")" @bind="from" @bind:after="Load" required /></div>
<div class="field"><label for="report-to">To</label><input id="report-to" type="date" min="@from.ToString("yyyy-MM-dd")" max="@TodayText" @bind="to" @bind:after="Load" required /></div>}
</section>
@if(Saving){<p role="status">Updating reports…</p>}
@if(Store.PendingCount>0 && Store.User?.IsDemo!=true){<p class="notice">@Store.PendingCount pending changes are excluded until synchronization finishes.</p>}
<ErrorBanner Message="@Error" />
@if(summary is {} total){
<p class="applied-range" role="status">Showing reports for <strong>@appliedFrom.ToString("MMM d, yyyy") – @appliedTo.ToString("MMM d, yyyy")</strong></p>


<section class="metric-grid section">@foreach(var metric in new[]{("Revenue",total.RevenueCentavos),("Item cost",total.CostCentavos),("Gross profit",total.GrossProfitCentavos),("Expenses",total.ExpenseCentavos),("Net profit",total.ProfitCentavos)}){<article class="card"><span class="card-label">@metric.Item1</span><div class="metric-value">@Money(metric.Item2)</div></article>}<article class="card"><span class="card-label">Transactions / items sold</span><div class="metric-value">@total.Transactions / @Quantity(total.ItemCount)</div></article></section>
<section class="card section"><h2>Sales trends</h2><div class="table-scroll"><table role="table" class="sales-trends" aria-label="Sales trends"><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Period</th><th scope="col" role="columnheader">Revenue</th><th scope="col" role="columnheader">Item cost</th><th scope="col" role="columnheader">Gross profit</th><th scope="col" role="columnheader">Expenses</th><th scope="col" role="columnheader">Net profit</th></tr></thead><tbody role="rowgroup">@foreach(var row in trends){<tr role="row"><td role="cell" data-label="Period"><span class="report-name">@FriendlyDate(row.Period,Today())</span></td><td role="cell" data-label="Revenue"><span class="report-number">@Money(row.RevenueCentavos)</span></td><td role="cell" data-label="Item cost"><span class="report-number">@Money(row.CostCentavos)</span></td><td role="cell" data-label="Gross profit"><span class="report-number">@Money(row.GrossProfitCentavos)</span></td><td role="cell" data-label="Expenses"><span class="report-number">@Money(row.ExpenseCentavos)</span></td><td role="cell" data-label="Net profit"><span class="report-number">@Money(row.ProfitCentavos)</span></td></tr>}</tbody></table></div>@if(trends.Count==0){<p>No sales or expenses in this period.</p>}</section>
<section class="card section"><h2>Item performance</h2><div class="table-scroll"><table role="table" aria-label="Item performance"><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Item</th><th scope="col" role="columnheader">Quantity</th><th scope="col" role="columnheader">Revenue</th><th scope="col" role="columnheader">Item cost</th><th scope="col" role="columnheader">Gross profit</th></tr></thead><tbody role="rowgroup">@foreach(var row in items){<tr role="row"><td role="cell" data-label="Item"><span class="report-name">@row.ItemName</span></td><td role="cell" data-label="Quantity"><span class="report-number">@Quantity(row.Quantity)</span></td><td role="cell" data-label="Revenue"><span class="report-number">@Money(row.RevenueCentavos)</span></td><td role="cell" data-label="Item cost"><span class="report-number">@Money(row.CostCentavos)</span></td><td role="cell" data-label="Gross profit"><span class="report-number">@Money(row.ProfitCentavos)</span></td></tr>}</tbody></table></div></section>
<section class="card section"><h2>Expenses by category</h2><div class="table-scroll"><table role="table" aria-label="Expenses by category"><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Category</th><th scope="col" role="columnheader">Total</th><th scope="col" role="columnheader">Percentage</th></tr></thead><tbody role="rowgroup">@foreach(var row in expenses){<tr role="row"><td role="cell" data-label="Category"><span class="report-name">@row.Category</span></td><td role="cell" data-label="Total"><span class="report-number">@Money(row.AmountCentavos)</span></td><td role="cell" data-label="Percentage"><span class="report-number">@(row.Percentage?.ToString("0.0")??"0")%</span></td></tr>}</tbody></table></div></section>}}
</div>
