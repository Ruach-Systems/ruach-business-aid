@namespace Ruach.BusinessAid.Client.Pages
@page "/admin"
@layout AdminLayout
@inherits PageBase
@inject ApiClient Api
<PageTitle>RUACH Admin | Business Aid</PageTitle>
<div class="admin-shell">
<aside class="admin-sidebar"><a class="admin-brand" href="/businesses"><BrandLogo Reversed="true" /></a><span class="admin-label">Platform admin</span>
<nav class="admin-navigation" aria-label="Admin sections">@foreach(var section in new[]{"Overview","Requests","Businesses","Users","Audit trail","More"}) {
<button class="@(section=="More" ? "nav-more" : section=="Audit trail" ? "nav-audit" : "") @((tab==section || (tab=="Audit trail" && section=="More")) ? "selected" : "")" aria-pressed="@(tab==section ? "true" : "false")" disabled="@Saving" @onclick="()=>ChangeTab(section)"><Icon Name="@(section=="Overview" ? "home" : section=="Businesses" ? "items" : section=="Requests" ? "receipt" : section=="Users" ? "users" : "more")" /><span class="nav-label">@section</span>@if(section=="Requests" && PendingCount>0){<span class="request-count">@PendingCount</span>}</button> }</nav>
<a class="admin-return" href="/businesses">← My businesses</a><span class="admin-identity">@Store.User?.DisplayName</span></aside>
<main class="admin-content"><header class="admin-heading"><div><span class="card-label">RUACH Admin</span><h1 tabindex="-1" @ref="heading">@(selectedBusiness?.Name ?? selectedUser?.DisplayName ?? (review is null ? tab : "Review request"))</h1><p>Review requests and understand your businesses.</p></div><button class="button ghost" disabled="@(Saving || !Store.Online)" @onclick="Load">Refresh</button></header>

<ErrorBanner Message="@Error" />
@if (!Store.Online) { <p class="account-notice" role="status">Connect to review requests or manage accounts. Admin data is not saved offline.</p> }
@if (Store.User?.IsAdmin != true) { <p role="alert">RUACH Admin access is required.</p> }
else {

@if (data is null) { <p role="status">@(Saving ? "Loading dashboard…" : "Refresh to load the dashboard.")</p> }
else {
<p role="status">@message</p>
@if(selectedBusiness is not null) { <button class="button ghost" @onclick='()=>ChangeTab("Businesses")'>← Back to businesses</button><AdminBusinessDetails @key="selectedBusiness.Id" Business="selectedBusiness" Owner="@Owner(selectedBusiness.OwnerUid)" /> }
else if(selectedUser is not null) { <button class="button ghost" @onclick='()=>ChangeTab("Users")'>← Back to users</button><AdminUserDetails @key="selectedUser.Uid" User="selectedUser" Businesses="data.Businesses" Requests="data.Requests" OpenBusiness="OpenBusiness" /> }
else {
@if(tab=="More") { <section class="card"><h2>More</h2><button class="button ghost" @onclick='()=>ChangeTab("Audit trail")'>Audit trail</button><p><a href="/businesses">My businesses</a></p><p><a href="/settings">Account settings</a></p></section> }
@if(tab=="Overview") {
<section class="card pending-panel"><div class="section-heading"><h2>Pending business requests <span class="request-count">@PendingCount</span></h2><button class="button ghost" @onclick='()=>ChangeTab("Requests")'>View all</button></div><p>Review these requests to help owners get started.</p>
@foreach(var request in data.Requests.Where(x=>x.Status=="Pending").OrderBy(x=>x.CreatedAt).ThenBy(x=>x.Id).Take(5)) {
<article class="pending-row"><div><strong>@request.Name</strong><small>@Owner(request.OwnerUid)?.DisplayName · @request.DefaultLocation</small><small>@request.CreatedAt.ToOffset(TimeSpan.FromHours(8)).ToString("MMM d, yyyy")</small></div><button class="button ghost" @onclick="()=>Review(request)">Review request</button></article> }
@if(PendingCount==0){<p class="empty-state">All caught up. No pending requests.</p>}</section>
<div class="admin-counts"><article><strong>@data.Users.Count</strong><span>Total users</span></article><article><strong>@data.Businesses.Count</strong><span>Total businesses</span></article><article><strong>@data.Users.Count(x=>JoinedInPeriod(x.CreatedAt))</strong><span>New users @CountPeriodLabel</span></article><article><strong>@data.Businesses.Count(x=>JoinedInPeriod(x.CreatedAt))</strong><span>New businesses @CountPeriodLabel</span></article></div>
<AdminPerformance @key="refreshVersion" OpenBusiness="OpenBusiness" RangeChanged="SetCountRange" />
}
@if (tab=="Requests") {
@if(review is null){<div class="field"><label for="request-status">Request status</label><select id="request-status" @bind="status"><option>Pending</option><option>Approved</option><option>Rejected</option><option>All</option></select></div>}
@if (review is not null) {
<section class="card request-form"><span class="status-badge pending">Pending</span><h2>@review.Name</h2><p>Submitted @review.CreatedAt.ToOffset(TimeSpan.FromHours(8)).ToString("MMM d, yyyy")</p><dl class="account-details"><div><dt>Owner</dt><dd>@Owner(review.OwnerUid)?.DisplayName</dd></div><div><dt>Email</dt><dd>@Owner(review.OwnerUid)?.Email</dd></div><div><dt>Mobile (not SMS-verified)</dt><dd>@(Owner(review.OwnerUid)?.PhoneNumber ?? "New number required")</dd></div><div><dt>Location</dt><dd>@review.DefaultLocation</dd></div><div><dt>Existing businesses</dt><dd>@Owner(review.OwnerUid)?.BusinessCount</dd></div></dl>
<p class="account-notice">Approval creates an empty workspace. No items, stock, sales, or expenses will be copied.</p>
<div class="field"><label for="decision-reason">Reason for rejection</label><textarea id="decision-reason" @bind="reason" @bind:event="oninput" maxlength="1000" placeholder="Required if rejecting. The owner will see this reason."></textarea><small>@reason.Length / 1,000</small></div>
@if (confirmDecision is { } approve) { <div class="account-notice" role="alert"><strong>@(approve ? "Approve this business?" : "Reject this request?")</strong><p>@(approve ? "An independent empty workspace will be created for the owner." : reason)</p><div class="account-actions-row"><button class="button ghost" @onclick="()=>confirmDecision=null">Keep reviewing</button><button class="button primary" disabled="@(Saving || !Store.Online)" @onclick="Decide">Confirm @(approve ? "approval" : "rejection")</button></div></div> }
else { <div class="account-actions-row decision-actions"><button class="button ghost" @onclick="()=>review=null">Close</button><button class="button danger" disabled="@(Saving || !Store.Online || string.IsNullOrWhiteSpace(reason))" @onclick="()=>confirmDecision=false">Reject with reason</button><button class="button primary" disabled="@(Saving || !Store.Online || Owner(review.OwnerUid)?.PhoneNumber is null)" @onclick="()=>confirmDecision=true">Approve business</button></div> }
</section> }
@if(review is null){<div class="stack">@foreach (var request in data.Requests.Where(x=>status=="All" || x.Status==status)) { <article class="card"><div class="section-heading"><h3>@request.Name</h3><span class="status-badge @request.Status.ToLowerInvariant()">@request.Status</span></div><p>@Owner(request.OwnerUid)?.DisplayName · @request.DefaultLocation · @request.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</p>@if (request.Status=="Pending") { <button class="button ghost" @onclick="()=>Review(request)">Review request</button> } else { <p>@request.Reason</p><small>Decided @request.DecidedAt?.ToLocalTime().ToString("g") by @Owner(request.DecidedBy ?? Guid.Empty)?.Email</small> }</article> }</div>
@if(!data.Requests.Any(x=>status=="All" || x.Status==status)) { <p class="card empty-state">No @status.ToLowerInvariant() requests.</p> }}
}
@if(tab is "Users" or "Businesses") { <div class="field"><label for="admin-search">Search @tab.ToLowerInvariant()</label><input id="admin-search" type="search" maxlength="200" disabled="@Saving" @bind="search" @bind:after="SearchDirectory" placeholder="Name, email, or location" /></div> }
@if(tab=="Users") {
@if (transferFrom is not null) {
<section class="card request-form"><h2>Transfer mobile number</h2><p><strong>@transferFrom.PhoneNumber</strong> from @transferFrom.DisplayName (@transferFrom.Email)</p><p class="account-notice">After the transfer, this owner must add a new unique number before entering any business. Complete an offline identity review first.</p>
<form class="form-card" @onsubmit="PrepareTransfer" @onsubmit:preventDefault>
<div class="field"><label for="recipient">Recipient account</label><select id="recipient" @bind="recipientId" disabled="@confirmTransfer" required><option value="">Select an owner</option>@foreach(var user in data.Users.Where(x=>x.Uid!=transferFrom.Uid)) { <option value="@user.Uid">@user.DisplayName — @user.Email</option> }</select></div>
<div class="field"><label for="transfer-reason">Reason / identity review reference</label><textarea id="transfer-reason" @bind="transferReason" readonly="@confirmTransfer" required maxlength="1000"></textarea></div>
<label class="account-check"><input type="checkbox" @bind="identityChecked" disabled="@confirmTransfer" required />I completed the offline identity review and confirmed the recipient.</label>
@if(confirmTransfer && Recipient is { } recipient) { <div class="account-notice" role="alert"><strong>Confirm transfer to @recipient.Email?</strong><p>Recipient's existing number: @(recipient.PhoneNumber ?? "None"). It will be replaced. The previous owner’s business access will pause.</p><button type="button" class="button primary" disabled="@(Saving || !Store.Online)" @onclick="Transfer">Confirm transfer</button></div> }
else { <button class="button primary" disabled="@(Saving || !Store.Online || !identityChecked || Recipient is null)">Review transfer</button> }
<button type="button" class="button ghost" @onclick="()=>transferFrom=null">Cancel</button>
</form></section> }
<div class="business-grid">@foreach (var user in directory.Users) { <article class="card"><h3>@user.DisplayName</h3><p>@user.Email</p><dl class="account-details"><div><dt>Mobile (not SMS-verified)</dt><dd>@(user.PhoneNumber ?? "Number required")</dd></div><div><dt>Businesses</dt><dd>@user.BusinessCount</dd></div><div><dt>Joined</dt><dd>@user.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</dd></div></dl><button class="button ghost" @onclick="()=>OpenUser(user)">View user</button><button class="button ghost" disabled="@(Saving || !Store.Online || user.PhoneNumber is null)" @onclick="()=>BeginTransfer(user)">Transfer phone number</button></article> }</div>
@if(directory.Users.Count==0) { <p>No matching users.</p> }
}
@if(tab=="Businesses") {
<div class="business-grid">@foreach (var business in directory.Businesses) { <article class="card"><span class="status-badge approved">Approved</span><h3>@business.Name</h3><p>@business.DefaultLocation</p><dl class="account-details"><div><dt>Owner</dt><dd>@Owner(business.OwnerUid)?.Email</dd></div><div><dt>Created</dt><dd>@business.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</dd></div><div><dt>Currency / time zone</dt><dd>PHP · Asia/Manila</dd></div></dl>@if(directory.Totals.Find(x=>x.Id==business.Id) is {} total){<div class="directory-totals"><small>This month</small><p>Revenue <strong>@Money(total.RevenueCentavos)</strong></p><p>Expenses <strong>@Money(total.ExpenseCentavos)</strong></p><p>Net profit <strong>@Money(total.ProfitCentavos)</strong></p></div>}<button class="button ghost" @onclick="()=>OpenBusiness(business.Id)">View business</button></article> }</div>
@if(directory.Businesses.Count==0) { <p>No matching businesses.</p> }
}
@if(tab is "Users" or "Businesses") { <div class="admin-paging"><button class="button ghost" disabled="@(Saving || directoryPage==0)" @onclick="()=>DirectoryPage(-1)">Previous</button><span>Page @(directoryPage+1)</span><button class="button ghost" disabled="@(Saving || (directoryPage+1)*25>=DirectoryCount)" @onclick="()=>DirectoryPage(1)">Next</button></div> }
@if(tab=="Audit trail") { <p>Most recent 200 actions. The database retains the full audit history.</p><div class="stack">@foreach(var entry in data.Audit) { <article class="card"><h3>@entry.Action</h3><p>@Owner(entry.ActorUid)?.Email · @entry.CreatedAt.ToLocalTime().ToString("g")</p><p>Owner: @Owner(entry.SubjectUid)?.Email</p>@if(entry.RecipientUid is { } recipient) { <p>@entry.PhoneNumber → @Owner(recipient)?.Email (replaced @(entry.PreviousRecipientPhone ?? "no number"))</p> }<p>@entry.Reason</p></article> }@if(data.Audit.Count==0) { <p>No admin actions yet.</p> }</div> }
}
}
}</main></div>
@code {
    private ElementReference heading;
    private bool focusHeading;
    protected override async Task OnAfterRenderAsync(bool firstRender){ if(focusHeading){focusHeading=false;await heading.FocusAsync();} }
    private void OpenUser(AdminUser user){selectedUser=user;focusHeading=true;}
    private AdminOverview? data;
    private Business? selectedBusiness;
    private AdminUser? selectedUser;
    private int directoryPage, refreshVersion;
    private int PendingCount => data?.Requests.Count(x=>x.Status=="Pending") ?? 0;
    private AdminDirectory directory=new();
    private int DirectoryCount => directory.Total;
    private DateOnly countFrom=new(Today().Year,Today().Month,1),countTo=Today();
    private string CountPeriodLabel=>countFrom==new DateOnly(Today().Year,Today().Month,1) && countTo==Today() ? "this month" : "in selected period";
    private void SetCountRange((string From,string To) range){countFrom=DateOnly.Parse(range.From);countTo=DateOnly.Parse(range.To);}
    private bool JoinedInPeriod(DateTimeOffset date) { var local=DateOnly.FromDateTime(date.ToOffset(TimeSpan.FromHours(8)).Date); return local>=countFrom && local<=countTo; }
    private void OpenBusiness(Guid id) { focusHeading=true; selectedBusiness=data?.Businesses.Find(x=>x.Id==id); selectedUser=null; tab="Businesses"; }

    private BusinessRequest? review;
    private AdminUser? transferFrom;
    private string tab="Overview", status="Pending", search="", reason="", message="", recipientId="", transferReason="";
    private bool? confirmDecision;
    private bool identityChecked, confirmTransfer;
    private AdminUser? Recipient => Guid.TryParse(recipientId,out var id) ? Owner(id) : null;
    private AdminUser? Owner(Guid id) => data?.Users.Find(x=>x.Uid==id);
    private bool Match(params string?[] values) => values.Any(x=>x?.Contains(search,StringComparison.OrdinalIgnoreCase)==true);
    protected override async Task OnInitializedAsync() { if(Store.Online && Store.User?.IsAdmin==true) await Load(); }
    private Task Load() => Run(async()=> { data=null; data=await Api.Get<AdminOverview>("/api/admin"); refreshVersion++; review=null; transferFrom=null; selectedBusiness=null; selectedUser=null; if(tab is "Users" or "Businesses")await ReadDirectory(); });
    private async Task ChangeTab(string value) { focusHeading=true; tab=value; search=""; review=null; transferFrom=null; selectedBusiness=null; selectedUser=null; directoryPage=0; if(tab is "Users" or "Businesses") await LoadDirectory(); }
    private async Task SearchDirectory(){ directoryPage=0; await LoadDirectory(); }
    private async Task DirectoryPage(int delta){directoryPage+=delta;await LoadDirectory();}
    private Task LoadDirectory()=>Run(ReadDirectory);
    private async Task ReadDirectory(){ directory=new();if(Store.Online)directory=await Api.Get<AdminDirectory>($"/api/admin/directory/{tab.ToLowerInvariant()}?search={Uri.EscapeDataString(search)}&from={Period("month").From}&to={Period("month").To}&page={directoryPage+1}&pageSize=25"); }
    private void Review(BusinessRequest value) { focusHeading=true; tab="Requests"; review=value; reason=""; confirmDecision=null; }
    private Task Decide() => Run(async()=> {
        if (!Store.Online || review is null || confirmDecision is null) return;
        await Api.Post($"/api/admin/requests/{review.Id}/decision",new DecisionInput(confirmDecision.Value,confirmDecision.Value ? "" : reason.Trim()));
        message=confirmDecision.Value ? "Business approved. Its empty workspace is ready." : "Request rejected. The owner can update and resubmit.";
        data=await Api.Get<AdminOverview>("/api/admin"); review=null; confirmDecision=null;
    });
    private void BeginTransfer(AdminUser user) { transferFrom=user; recipientId=""; transferReason=""; identityChecked=false; confirmTransfer=false; }
    private void PrepareTransfer() { if(Recipient is not null && identityChecked && !string.IsNullOrWhiteSpace(transferReason)) confirmTransfer=true; }
    private Task Transfer() => Run(async()=> {
        if(!Store.Online || transferFrom?.PhoneNumber is null || Recipient is not { } recipient || !confirmTransfer) return;
        await Api.Post("/api/admin/phone-transfer",new PhoneTransferInput(transferFrom.Uid,recipient.Uid,transferFrom.PhoneNumber,transferReason,identityChecked,recipient.PhoneNumber));
        data=await Api.Get<AdminOverview>("/api/admin"); transferFrom=null; tab="Audit trail"; message="Mobile number transferred. The previous owner must add a new number.";
        await Store.RefreshAccount();
    });
}
