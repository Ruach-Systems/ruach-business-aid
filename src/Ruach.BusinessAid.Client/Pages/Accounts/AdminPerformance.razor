@namespace Ruach.BusinessAid.Client.Pages
@inherits PageBase
@inject ApiClient Api
<section class="admin-performance" aria-label="Financial performance">
@if (Workspace && Store.Online && analytics is not null)
{
    <section class="analytics-highlights analytics-calendar-highlights" aria-label="Current sales totals">
        <article class="card analytics-metric analytics-week"><span>Sales this week</span><strong>@(weekSales is { } week ? Money(week) : "Unavailable")</strong><small>@weekLabel</small></article>
        <article class="card analytics-metric analytics-month"><span>Sales this month</span><strong>@(monthSales is { } month ? Money(month) : "Unavailable")</strong><small>@monthLabel</small></article>
    </section>
}
<section class="card performance-filter-panel">
    <h2>@(OwnerId.HasValue ? "Owned-business performance" : "Financial performance")</h2>
    <form novalidate class="performance-filters" @onsubmit="Load" @onsubmit:preventDefault>
        <div class="field">
            <label for="admin-period">Period</label>
            <select id="admin-period" disabled="@FiltersDisabled" @bind="period" @bind:after="SetPeriod">
                <option value="today">Today</option>
                @if (BusinessId.HasValue && Today() > MinimumDate)
                {
                    <option value="yesterday">Yesterday</option>
                }
                <option value="week">This week</option>
                <option value="month">This month</option>
                <option value="last30">Last 30 days</option>
                <option value="custom">Custom range</option>
            </select>
        </div>
        @if (period == "custom")
        {
            <div class="performance-dates">
                <div class="field">
                    <label for="admin-from">From date</label>
                    <input id="admin-from" type="date" min="@EarliestDate" max="@FromMaximum" disabled="@FiltersDisabled" @bind="from" @bind:after="CustomDateChanged" required aria-invalid="@(FromError is not null ? "true" : null)" aria-describedby="@(FromError is not null ? "analytics-from-error" : null)" />
                    @if (FromError is { } fromError) { <small class="date-error" id="analytics-from-error" role="status">@fromError</small> }
                </div>
                <div class="field">
                    <label for="admin-to">To date</label>
                    <input id="admin-to" type="date" min="@ToMinimum" max="@Today().ToString("yyyy-MM-dd")" disabled="@FiltersDisabled" @bind="to" @bind:after="CustomDateChanged" required aria-invalid="@(ToError is not null ? "true" : null)" aria-describedby="@(ToError is not null ? "analytics-to-error" : null)" />
                    @if (ToError is { } toError) { <small class="date-error" id="analytics-to-error" role="status">@toError</small> }
                </div>
            </div>
            @if (!BusinessId.HasValue)
            {
                <button type="submit" class="button primary" disabled="@(FiltersDisabled || FromError is not null || ToError is not null)">Apply range</button>
            }
        }
    </form>
    @if (analytics is not null && Store.Online)
    {
        <p class="admin-caption performance-range">@AppliedDateLabel · Synced records</p>
    }
</section>
@if(OwnerId.HasValue){<p>Totals include businesses owned by this user. They do not measure the user's individual actions.</p>}
<ErrorBanner Message="@Error" />
@if(!Store.Online){<p class="account-notice" role="status">@(Workspace ? "Connect to load business financial data. It is not saved offline." : "Connect to load admin financial data. It is not saved offline.")</p>}
else if(Saving){<p role="status">Loading financial performance…</p>}
else if (analytics is { } result && BusinessId.HasValue)
{
    @if (Workspace)
    {
        <section class="analytics-highlights" aria-label="Selected-period highlights">
            <article class="card analytics-metric analytics-profit"><span>Net profit</span><strong>@Money(selectedProfit)</strong><small>Selected period</small></article>
            <article class="card analytics-metric analytics-top-item"><span>Top item by revenue</span>@TopItemContent</article>
        </section>
    }
    <div class="admin-charts">
        <PerformanceTrend @key="result" Rows="businessTrend" RangeLabel="@ChartRangeLabel" />
    </div>
}
else if(analytics is {} a){
<div class="admin-financials">@foreach(var metric in new[]{("Revenue",a.Summary.RevenueCentavos),("Item cost",a.Summary.CostCentavos),("Gross profit",a.Summary.GrossProfitCentavos),("Expenses",a.Summary.ExpenseCentavos),("Net profit",a.Summary.ProfitCentavos)}) {
<article class="card @(metric.Item1=="Net profit" ? "net-profit" : "")"><span class="card-label">@metric.Item1</span><strong>@Money(metric.Item2)</strong></article> }</div>
<p class="admin-caption">@Quantity(a.Summary.Transactions) transactions · @Quantity(a.Summary.ItemCount) items sold</p>
<div class="admin-charts">
<PerformanceTrend @key="a" Rows="a.Trend" />
@if(!BusinessId.HasValue){<section class="card"><div class="section-heading"><h2>Top businesses</h2><span class="admin-caption">By revenue</span></div>@foreach(var business in a.TopBusinesses){<button class="top-business" @onclick="()=>OpenBusiness.InvokeAsync(business.Id)"><span>@business.Name</span><strong>@Money(business.RevenueCentavos)</strong></button>}@if(a.TopBusinesses.Count==0){<p>No businesses yet.</p>}</section>}
</div>
}
</section>
@code {
    [Parameter] public bool Workspace { get; set; }
    [Parameter] public bool Busy {get;set;}
    [Parameter] public Guid? BusinessId {get;set;}
    [Parameter] public Guid? OwnerId {get;set;}
    [Parameter] public EventCallback<Guid> OpenBusiness {get;set;}
    [Parameter] public EventCallback<(string From,string To)> RangeChanged {get;set;}
    [Parameter] public RenderFragment? TopItemContent { get; set; }
    private AdminAnalytics? analytics;
    private long? weekSales, monthSales;
    private long selectedProfit;
    private string weekLabel = "", monthLabel = "";
    private IReadOnlyList<SalesTrend> businessTrend = [];
    private const int MinimumChartDays = 7;
    private DateOnly chartFrom;
    private string ChartRangeLabel => $"{chartFrom:MMM d, yyyy} – {appliedTo:MMM d, yyyy}";
    private string period="month";
    private const string EarliestDate = "2026-01-01";
    private static readonly DateOnly MinimumDate = new(2026, 1, 1);
    private DateOnly? from = new DateOnly(Today().Year, Today().Month, 1), to = Today();
    private DateOnly appliedFrom, appliedTo;
    private string AppliedDateLabel => appliedFrom == appliedTo
        ? appliedFrom.ToString("MMM d, yyyy")
        : $"{appliedFrom:MMM d, yyyy} – {appliedTo:MMM d, yyyy}";
    private bool FiltersDisabled => Saving || Busy || !Store.Online;
    private string FromMaximum => (to is { } end && end >= MinimumDate && end <= Today() ? end : Today()).ToString("yyyy-MM-dd");
    private string ToMinimum => (from is { } start && start >= MinimumDate && start <= Today() ? start : MinimumDate).ToString("yyyy-MM-dd");
    private string? FromError => DateError(from, "from");
    private string? ToError => DateError(to, "to")
        ?? (to < from ? "To date must be on or after the from date." : null);

    private static string? DateError(DateOnly? value, string label) => value switch
    {
        null => $"Enter a {label} date.",
        { } date when date < MinimumDate => "Use January 1, 2026 or later.",
        { } date when date > Today() => "Choose today or earlier.",
        _ => null
    };
    private Guid? loadedBusiness,loadedOwner;
    private bool initialized;
    protected override async Task OnParametersSetAsync()
    {
        if (initialized && loadedBusiness == BusinessId && loadedOwner == OwnerId) return;
        initialized = true;
        analytics = null;
        weekSales = monthSales = null;
        loadedBusiness = BusinessId;
        loadedOwner = OwnerId;
        if (period == "custom") await Load();
        else await SetPeriod();
    }
    private async Task SetPeriod()
    {
        if (period == "custom")
        {
            if (analytics is not null)
            {
                from = appliedFrom;
                to = appliedTo;
            }
            return;
        }

        var today = Today();
        to = period == "yesterday" ? today.AddDays(-1) : today;
        var start = period switch
        {
            "yesterday" => today.AddDays(-1),
            "last30" => today.AddDays(-29),
            _ => DateOnly.Parse(Period(period).From)
        };
        from = start < MinimumDate ? MinimumDate : start;
        await Load();
    }

    private async Task CustomDateChanged()
    {
        if (BusinessId.HasValue && FromError is null && ToError is null &&
            (analytics is null || from != appliedFrom || to != appliedTo))
        {
            await Load();
        }
    }

    private Task Load() => Run(async () =>
    {
        if (!Store.Online || (!Workspace && Store.User?.IsAdmin != true)) return;
        if (FromError is not null || ToError is not null || from is not { } start || to is not { } end) return;

        var trendStart = BusinessId.HasValue && end.DayNumber - start.DayNumber + 1 < MinimumChartDays
            ? end.AddDays(1 - MinimumChartDays)
            : start;
        var path = Workspace
            ? $"/api/businesses/{BusinessId}/overview/analytics?from={trendStart:yyyy-MM-dd}&to={end:yyyy-MM-dd}"
            : $"/api/admin/analytics?from={trendStart:yyyy-MM-dd}&to={end:yyyy-MM-dd}" +
                (BusinessId.HasValue ? $"&business={BusinessId}" : "") +
                (OwnerId.HasValue ? $"&owner={OwnerId}" : "");
        var chartData = await Api.Get<AdminAnalytics>(path);
        if (BusinessId.HasValue)
        {
            businessTrend = DailyTrend(chartData.Trend, trendStart, end);
            chartFrom = trendStart;
        }
        appliedFrom = start;
        appliedTo = end;
        analytics = chartData;
        var recordsTask = RangeChanged.InvokeAsync((start.ToString("yyyy-MM-dd"), end.ToString("yyyy-MM-dd")));
        if (Workspace)
        {
            selectedProfit = InRange(chartData.Trend, start, end).Sum(day => day.ProfitCentavos);
            await Task.WhenAll(recordsTask, LoadCurrentSales(chartData, trendStart, end));
        }
        else await recordsTask;
    });

    private async Task LoadCurrentSales(AdminAnalytics chartData, DateOnly chartStart, DateOnly chartEnd)
    {
        var today = Today();
        var weekStart = DateOnly.Parse(Period("week").From);
        var monthStart = new DateOnly(today.Year, today.Month, 1);
        var firstDay = weekStart < monthStart ? weekStart : monthStart;
        weekLabel = $"{weekStart:MMM d} – {today:MMM d}";
        monthLabel = today.ToString("MMMM yyyy");

        var current = chartStart <= firstDay && chartEnd == today
            ? chartData
            : await Api.Get<AdminAnalytics>($"/api/businesses/{BusinessId}/overview/analytics?from={firstDay:yyyy-MM-dd}&to={today:yyyy-MM-dd}");
        weekSales = InRange(current.Trend, weekStart, today).Sum(day => day.RevenueCentavos);
        monthSales = InRange(current.Trend, monthStart, today).Sum(day => day.RevenueCentavos);
    }

    private static IEnumerable<SalesTrend> InRange(IEnumerable<SalesTrend> rows, DateOnly start, DateOnly end)
    {
        var fromDate = start.ToString("yyyy-MM-dd");
        var toDate = end.ToString("yyyy-MM-dd");
        return rows.Where(day => string.CompareOrdinal(day.Period, fromDate) >= 0 && string.CompareOrdinal(day.Period, toDate) <= 0);
    }

    private static IReadOnlyList<SalesTrend> DailyTrend(IReadOnlyList<SalesTrend> rows, DateOnly start, DateOnly end)
    {
        if (rows.Count == 0) return rows;
        var byDate = rows.ToDictionary(row => row.Period);
        return Enumerable.Range(start.DayNumber, end.DayNumber - start.DayNumber + 1)
            .Select(day =>
            {
                var date = DateOnly.FromDayNumber(day).ToString("yyyy-MM-dd");
                return byDate.GetValueOrDefault(date) ?? new SalesTrend(date, 0, 0, 0);
            }).ToList();
    }
}
