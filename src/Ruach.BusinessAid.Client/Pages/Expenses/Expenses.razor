@namespace Ruach.BusinessAid.Client.Pages
@page "/expenses"
@inherits PageBase
@inject IJSRuntime JS
<CascadingValue Value="NumberDrafts">
<div class="page">
<PageHeading Title="Expenses" Eyebrow="Optional operating costs" Description="Record costs such as rent, transport, utilities, and labor.">
<span class="date-chip">Today · @Money(Store.Expenses.Where(x=>x.ExpenseDate==Today().ToString("yyyy-MM-dd")).Sum(x=>x.AmountCentavos))</span>
</PageHeading>
<div class="split">
<form novalidate @ref="expenseForm" class="card form-card expense-form @(id is not null ? "is-editing" : "")" data-numeric-validation="true" @onsubmit="Save" @onsubmit:preventDefault>
<div class="section-heading">
<h2>@(id is null?"Add expense":"Edit expense")</h2>
@if(id is not null){
<button type="button" class="button ghost small" @onclick="Reset">Cancel edit</button>}
</div>
@if(id is not null){
<div class="edit-notice" role="status"><strong>Editing expense</strong><span>@editingSummary</span><small>Update the details below, then choose Update expense to save your changes.</small></div>
}
<div class="field">
<label for="expense-date">Date</label>
<input id="expense-date" type="date" min="2026-01-01" max="@Today().ToString("yyyy-MM-dd")" @bind="date" required />
</div>
<div class="field">
<label for="expense-description">Description</label>
<input id="expense-description" @bind="description" required placeholder="e.g. Transportation" />
</div>
<div class="field">
<label for="expense-amount">Amount (₱)</label>
<MoneyInput StartEmpty="@(id is null)" @key="amountRevision" id="expense-amount" ValidityChanged="@(v => amountValid = v)" @bind-Value="amount" required />
</div>
<div class="field">
<label for="expense-category">Category</label>
<select id="expense-category" @bind="category">@foreach(var value in categories){
<option>@value</option>}
</select>
</div>
<ErrorBanner Message="@Error" />

<button class="button primary block" disabled="@(Saving)">@(id is null?"Save expense":"Update expense")</button>
</form>
<section>
<div class="section-heading">
<h2>Expense history</h2>
</div>
<div class="card expense-filters">
<div class="field"><label for="expense-period">Period</label><select id="expense-period" @bind="period" @bind:after="SetPeriod"><option value="today">Today</option><option value="yesterday">Yesterday</option><option value="week">This week</option><option value="month">This month</option><option value="all">All dates</option><option value="custom">Custom range</option></select></div>
@if(period == "custom"){
<div class="expense-dates">
<div class="field"><label for="expense-from">From</label><input id="expense-from" type="date" min="2026-01-01" max="@Today().ToString("yyyy-MM-dd")" @bind="from" @bind:after="ResetPage" /></div>
<div class="field"><label for="expense-to">To</label><input id="expense-to" type="date" min="2026-01-01" max="@Today().ToString("yyyy-MM-dd")" @bind="to" @bind:after="ResetPage" /></div>
</div>}
<div class="field"><label for="expense-filter-category">Category</label><select id="expense-filter-category" aria-label="Filter by category" @bind="filterCategory" @bind:after="ResetPage"><option value="">All categories</option>@foreach(var c in categories){<option>@c</option>}</select></div>
<div class="field"><label for="expense-search">Search descriptions</label><input id="expense-search" type="search" placeholder="Search descriptions…" @bind="search" @bind:event="oninput" @bind:after="ResetPage" /></div>
</div>
<button class="reset-filters" @onclick="ResetFilters">Reset filters</button>
@if(InvalidRange){<p role="alert" class="filter-error">Enter a valid date range.</p>}
else {
<div class="history-summary" role="status"><div><small>@RangeLabel</small><strong>@Filtered.Count expenses</strong></div><div><small>Total</small><strong>@Money(Filtered.Sum(x=>x.AmountCentavos))</strong></div></div>
<div class="stack">@foreach(var expense in Filtered.Skip((CurrentPage-1)*10).Take(10)){
<article class="card expense-entry @(id == expense.Id ? "is-editing" : "")">
<span class="list-icon">
<Icon Name="@ExpenseIcon(expense.Category)" />
</span>
<div class="list-main">
<strong>@expense.Description</strong>
<small>@expense.Category · @DateTime.Parse(expense.ExpenseDate).ToString("MMM d, yyyy")</small>
@if(id == expense.Id){<small class="editing-label">Editing this expense</small>}
</div>
<strong class="expense-amount">@Money(expense.AmountCentavos)</strong>
<div class="row-actions">
<button type="button" aria-label="@($"Edit {expense.Description} expense")" @onclick="()=>Edit(expense)"><Icon Name="edit" />Edit</button>
<button type="button" class="delete" aria-label="@($"Delete {expense.Description} expense")" @onclick="()=>Delete(expense)"><Icon Name="delete" />Delete</button>
</div>
</article>}
@if(!Filtered.Any()){
<div class="card empty">
<h3>@(Store.Expenses.Any() ? "No expenses match these filters" : "No expenses recorded")</h3>
<p>Add transport, utilities, labor, and other daily costs here.</p>
</div>}
</div>
@if(Filtered.Count > 0){<nav class="expense-pagination" aria-label="Expense history pages"><small>@((CurrentPage-1)*10+1)–@Math.Min(CurrentPage*10,Filtered.Count) of @Filtered.Count expenses</small><button class="button ghost" disabled="@(CurrentPage==1)" @onclick="()=>page=CurrentPage-1">Previous</button><button class="button primary" disabled="@(CurrentPage==PageCount)" @onclick="()=>page=CurrentPage+1">Next</button></nav>}
}
</section>
</div>
</div>

</CascadingValue>
