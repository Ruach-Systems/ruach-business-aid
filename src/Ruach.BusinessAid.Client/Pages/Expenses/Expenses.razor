@namespace Ruach.BusinessAid.Client.Pages
@page "/expenses"
@inherits PageBase
@inject IJSRuntime JS
<div class="page">
<PageHeading Title="Expenses" Eyebrow="Optional operating costs" Description="Record costs such as rent, transport, utilities, and labor.">
<span class="date-chip">Today · @Money(Store.Expenses.Where(x=>x.ExpenseDate==Today().ToString("yyyy-MM-dd")).Sum(x=>x.AmountCentavos))</span>
</PageHeading>
<div class="split">
<form class="card form-card expense-form" @onsubmit="Save" @onsubmit:preventDefault>
<div class="section-heading">
<h2>@(id is null?"Add expense":"Edit expense")</h2>
@if(id is not null){
<button type="button" class="button ghost small" @onclick="Reset">Cancel edit</button>}
</div>
<div class="field">
<label for="expense-date">Date</label>
<input id="expense-date" type="date" max="@Today().ToString("yyyy-MM-dd")" @bind="date" required />
</div>
<div class="field">
<label for="expense-description">Description</label>
<input id="expense-description" @bind="description" required placeholder="e.g. Transportation" />
</div>
<div class="field">
<label for="expense-amount">Amount (₱)</label>
<MoneyInput id="expense-amount" min="0" max="100000000" @bind-Value="amount" required />
</div>
<div class="field">
<label for="expense-category">Category</label>
<select id="expense-category" @bind="category">@foreach(var value in categories){
<option>@value</option>}
</select>
</div>
<ErrorBanner Message="@Error" />
<button class="button primary block" disabled="@Saving">@(id is null?"Save expense":"Update expense")</button>
</form>
<section>
<div class="section-heading">
<h2>Recent expenses</h2>
</div>
<div class="stack">@foreach(var expense in Store.Expenses.OrderByDescending(x=>x.ExpenseDate).ThenByDescending(x=>x.CreatedAt)){
<article class="card list-card">
<span class="list-icon">
<Icon Name="wallet" />
</span>
<div class="list-main">
<strong>@expense.Description</strong>
<small>@expense.Category · @expense.ExpenseDate</small>
</div>
<strong>@Money(expense.AmountCentavos)</strong>
<div class="row-actions">
<button type="button" aria-label="@($"Edit {expense.Description} expense")" @onclick="()=>Edit(expense)">Edit</button>
<button type="button" class="delete" aria-label="@($"Delete {expense.Description} expense")" @onclick="()=>Delete(expense)">×</button>
</div>
</article>}
@if(!Store.Expenses.Any()){
<div class="card empty">
<h3>No expenses recorded</h3>
<p>Add transport, utilities, labor, and other daily costs here.</p>
</div>}
</div>
</section>
</div>
</div>
