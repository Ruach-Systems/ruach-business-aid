@namespace Ruach.BusinessAid.Client.Pages
@page "/stock/adjust"
@inherits PageBase
<CascadingValue Value="NumberDrafts">
<div class="page narrow">
<BackLink To="/items" Text="Back to items" />
<PageHeading Title="Correct stock" Eyebrow="Physical count" Description="Replace the saved balance with the quantity you actually have." />
<form novalidate class="card form-card" data-numeric-validation="true" @onsubmit="Save" @onsubmit:preventDefault>
<div class="field"><label for="adjust-item">Item</label><select id="adjust-item" @bind="itemId" @bind:after="Choose" required><option value="@Guid.Empty">Select item</option>@foreach(var item in Store.AllItems){<option value="@item.Id">@item.Name@(!item.IsActive ? " (inactive)" : "")</option>}</select></div>
<div class="field"><label for="adjust-count">Counted quantity</label><QuantityInput StartEmpty="@(itemId == Guid.Empty)" @key="itemId" id="adjust-count" @bind-Value="count" ValidityChanged="@(v => countValid = v)" /></div>
<div class="field"><label for="adjust-reason">Reason</label><select id="adjust-reason" @bind="reason"><option>Stock count correction</option><option>Waste / spoilage</option><option>Return</option><option>Other</option></select></div>
<div class="field"><label for="adjust-note">Note</label><textarea id="adjust-note" @bind="note" maxlength="400"></textarea></div>
@if (Store.AllItems.FirstOrDefault(x => x.Id == itemId) is { } selected)
{
<section class="card soft" aria-label="Stock correction preview" aria-live="polite">
<strong>Stock correction preview</strong>
<p>Current stock: @Quantity(selected.CurrentQuantity)</p>
<p>Counted stock: @(countValid ? Quantity(count) : "—")</p>
<p>Adjustment: @(countValid ? $"{(count - selected.CurrentQuantity > 0 ? "+" : "")}{Quantity(count - selected.CurrentQuantity)}" : "—")</p>
</section>
}
<ErrorBanner Message="@Error" />
<div class="form-actions"><a class="button ghost" href="/items" @onclick="CancelDraft">Cancel</a><button class="button primary" disabled="@(Saving)">Save correction</button></div>
</form>
</div>

</CascadingValue>
