@namespace Ruach.BusinessAid.Client.Pages
@page "/sales"
@inherits PageBase
<div class="page narrow">
<PageHeading Title="What sold today?" Eyebrow="Fast daily entry" Description="Enter whole-item quantities. Stock is deducted automatically." />
<form novalidate id="sale-item-search" @onsubmit:preventDefault></form>
<form novalidate class="stack" data-numeric-validation="true" @onsubmit="Save" @onsubmit:preventDefault>
<section class="card form-card"><div class="field"><label for="sale-date">Sale date</label><input id="sale-date" type="date" min="2026-01-01" max="@Today().ToString("yyyy-MM-dd")" @bind="date" required /></div></section>
@if(Store.Items.Any()){<div class="sale-search"><div class="search-box"><label class="sr-only" for="sale-search">Search items to sell</label><input id="sale-search" form="sale-item-search" type="search" placeholder="Search items" autocomplete="off" @bind="search" @bind:event="oninput" /></div>
@if(search.Length>0){<small class="search-summary" aria-live="polite">Showing @MatchCount of @Store.Items.Count() items@(SelectedHiddenByName>0?$" · {SelectedHiddenByName} selected item{(SelectedHiddenByName==1?"":"s")} kept":"")</small>}</div>}
<section class="stack sale-lines">@foreach(var item in VisibleItems){Ensure(item.Id);<article class="card sale-line" @key="item.Id">
<div class="list-main"><strong>@item.Name</strong><div class="unit-pricing"><span>Price <b>@Money(item.SellingPriceCentavos)</b></span><span>Cost <b>@Money(item.UnitCostCentavos)</b></span><span>Stock <b class="@(item.CurrentQuantity<0?"negative-stock":"")">@Quantity(item.CurrentQuantity)</b></span></div>
</div>
<div class="stepper"><button type="button" aria-label="@($"Decrease {item.Name} quantity")" disabled="@(!QuantityValid(item.Id) || quantities[item.Id] == 0)" @onclick="()=>Change(item.Id,-1)">−</button><QuantityInput StartEmpty="true" EmptyAsZero="true" aria-label="@($"{item.Name} quantity sold")" @bind-Value="quantities[item.Id]" ValidityChanged="@(v => SetQuantityValidity(item.Id, v))" /><button type="button" aria-label="@($"Increase {item.Name} quantity")" disabled="@(!QuantityValid(item.Id) || quantities[item.Id] >= Rules.MaxQuantity)" @onclick="()=>Change(item.Id,1)">+</button></div>
@if(QuantityValid(item.Id) && quantities[item.Id]>0 && quantities[item.Id]>item.CurrentQuantity){<small class="stock-warning" role="alert">This sale will leave @Quantity(item.CurrentQuantity-quantities[item.Id]) in stock.</small>}
</article>}</section>
@if(Store.Items.Any() && !VisibleItems.Any()){<div class="card empty"><h3>No matching items</h3><p>Try another name.</p><button type="button" class="button ghost small" @onclick="ClearSearch">Clear search</button></div>}
@if(!Store.Items.Any()){<div class="card empty"><h3>Add items first</h3><p>Active items appear here for quick sales entry.</p><a class="button primary" href="/items/new">Add item</a></div>}
@if(TooManyLines){<p class="error-banner" role="alert">A sale can contain at most @Rules.MaxSaleLines different items. Save separate sales.</p>}
@if(HasNegativeResult){<div class="notice warning sale-warning" role="alert">One or more items will have negative stock. You can still save and correct or add stock later.</div>}
@if(Store.Items.Any()){<div class="sale-checkout @(TotalItems>0?"active":"")">
<section class="card dark totals-card" aria-label="Sale totals" aria-live="polite"><div><span class="card-label">Items</span><strong>@(InputsValid ? Quantity(TotalItems) : "—")</strong></div><div><span class="card-label">Sales</span><strong>@(InputsValid ? Money(Revenue) : "—")</strong></div><div><span class="card-label">Item cost</span><strong>@(InputsValid ? Money(Cost) : "—")</strong></div><div><span class="card-label">Gross profit</span><strong>@(InputsValid ? Money(Revenue-Cost) : "—")</strong></div></section>
<AppNotification Message="@message" /><ErrorBanner Message="@Error" />
<button class="button primary block" disabled="@(Saving||(InputsValid && TotalItems==0))">@(InputsValid ? $"Save {Quantity(TotalItems)} items" : "Correct quantities to save")</button>
</div>}
</form>
<section id="sales-history" class="section sales-history"><div class="section-heading"><h2>Sales history</h2><a href="/sales/history">View all</a></div>
@if(Store.Sales.Any()){<div class="stack">@foreach(var sale in Store.Sales.OrderByDescending(x=>x.SaleDate).ThenByDescending(x=>x.CreatedAt).ThenByDescending(x=>x.Id).Take(5)){<a class="card list-card sale-history-link" href="@($"/sales/{sale.Id}")" aria-label="@($"View sale of {Quantity(sale.TotalItems)} items for {Money(sale.TotalRevenueCentavos)}")"><span class="list-icon"><Icon Name="cart" /></span><div class="list-main"><strong>@Quantity(sale.TotalItems) items</strong><small>@FriendlyDate(sale.SaleDate,Today()) · @string.Join(", ",sale.Lines.Select(x=>x.ItemName))</small></div><strong class="sale-amount">@Money(sale.TotalRevenueCentavos)</strong></a>}</div>}
else{<div class="card empty"><p>No sales recorded yet.</p></div>}
<a class="button ghost block section" href="/sales/history">View all sales history by date</a>
</section>
</div>
