@namespace Ruach.BusinessAid.Client.Pages
@page "/sales"
@inherits PageBase
<CascadingValue Value="NumberDrafts">
<div class="page register">
    <form id="sale-item-search" @onsubmit:preventDefault></form>
    <form id="record-sale" data-numeric-validation="true" novalidate @onsubmit="Save" @onsubmit:preventDefault>
        <PageHeading Title="Sales register" Description="Select products to add them to the current sale.">
            @if (Store.Items.Any() || quantities.Count > 0)
            {
                <div class="field register-date">
                    <label for="sale-date">Sale date</label>
                    <input id="sale-date" type="date" min="2026-01-01" max="@Today().ToString("yyyy-MM-dd")" @bind="date" required />
                </div>
            }
        </PageHeading>

        @if (Store.Items.Any() || quantities.Count > 0)
        {
            <div class="register-layout">
                <section class="catalog" aria-labelledby="catalog-title">
                    <div class="panel-heading"><h2 id="catalog-title">Products</h2></div>
                    <label for="sale-search" class="sr-only">Search items to sell</label>
                    <input class="search" id="sale-search" type="search" form="sale-item-search" placeholder="Search products by name" autocomplete="off" @bind="search" @bind:event="oninput" />
                    <div class="product-grid">
                        @foreach (var item in Store.Items.Where(Matches))
                        {
                            var count = quantities.GetValueOrDefault(item.Id);
                            <button @key="item.Id" type="button" class="product @(count > 0 ? "selected" : "")"
                                    aria-label="@($"Add {item.Name} to sale")" aria-describedby="@($"price-{item.Id} stock-{item.Id}")""
                                    disabled="@(Saving || !QuantityValid(item.Id) || count >= Rules.MaxQuantity)" @onclick="() => Change(item.Id, 1)">
                                <strong>@item.Name</strong><span class="product-add" aria-hidden="true">+</span>
                                <b id="@($"price-{item.Id}")">@Money(item.SellingPriceCentavos)</b>
                                <small id="@($"stock-{item.Id}")">@Quantity(item.CurrentQuantity) in stock</small>
                                @if (count > 0) { <small class="in-cart">@Quantity(count) in cart</small> }
                            </button>
                        }
                    </div>
                    @if (!Store.Items.Any(Matches))
                    {
                        <div class="card empty" role="status"><h3>No matching products</h3>
                            <button type="button" class="button ghost small" @onclick="() => search = string.Empty">Clear search</button>
                        </div>
                    }
                </section>

                <section class="register-order" aria-labelledby="cart-title">
                    <div class="basket card" id="current-sale" @ref="cartElement" tabindex="-1">
                        <div class="panel-heading"><Icon Name="cart" /><h2 id="cart-title">Current sale</h2></div>
                        @if (quantities.Count == 0)
                        {
                            <p class="basket-empty">Your cart is empty.</p>
                        }
                        <div class="basket-lines">
                            @foreach (var item in CartItems)
                            {
                                var count = quantities[item.Id];
                                <article class="sale-line" @key="item.Id">
                                    <div class="line-heading"><strong>@item.Name</strong><b>@(QuantityValid(item.Id) ? Money(count * item.SellingPriceCentavos) : "—")</b></div>
                                    <small>@Money(item.SellingPriceCentavos) each</small>
                                    <div class="line-actions">
                                        <div class="stepper">
                                            <button type="button" aria-label="@($"Decrease {item.Name} quantity")" disabled="@(Saving || !QuantityValid(item.Id) || count == 0)" @onclick="() => Change(item.Id, -1)">−</button>
                                            <QuantityInput id="@($"sale-quantity-{item.Id}")" EmptyAsZero="true" disabled="@Saving" aria-label="@($"{item.Name} quantity sold")" @bind-Value="quantities[item.Id]" ValidityChanged="@(v => SetQuantityValidity(item.Id, v))" />
                                            <button type="button" aria-label="@($"Increase {item.Name} quantity")" disabled="@(Saving || !QuantityValid(item.Id) || count >= Rules.MaxQuantity)" @onclick="() => Change(item.Id, 1)">+</button>
                                        </div>
                                        <button type="button" class="remove-line" aria-label="@($"Remove {item.Name} from sale")" disabled="@Saving" @onclick="() => Remove(item.Id)">Remove</button>
                                    </div>
                                    @if (QuantityValid(item.Id) && count > 0 && count > item.CurrentQuantity)
                                    {
                                        <small class="stock-warning" role="status">This sale will leave @Quantity(item.CurrentQuantity - count) in stock.</small>
                                    }
                                </article>
                            }
                            @foreach (var id in UnavailableIds)
                            {
                                <div class="unavailable"><span>@(Store.Data.Items.Find(x => x.Id == id)?.Name ?? "Item") is no longer available.</span>
                                    <button type="button" class="button ghost small" disabled="@Saving" @onclick="() => Remove(id)">Remove unavailable item</button></div>
                            }
                        </div>
                    </div>
                    <div class="sale-checkout @(quantities.Count > 0 ? "active" : "")">
                        <div class="cart-tools"><a class="@(HasNegativeStock ? "stock-alert-link" : "")" href="#current-sale" @onclick="FocusCart" @onclick:preventDefault>@(HasNegativeStock ? "Review negative stock" : "View cart")</a>
                            <button type="button" aria-expanded="@(showTotals ? "true" : "false")" @onclick="() => showTotals = !showTotals">@(showTotals ? "Hide breakdown" : "Show breakdown")</button></div>
                        <section class="totals-card @(showTotals ? "expanded" : "")" aria-label="Sale totals" aria-live="polite">
                            <div><span>Items</span><strong>@(InputsValid ? Quantity(TotalItems) : "—")</strong></div>
                            <div class="amount-due"><span>Total</span><strong>@(InputsValid ? Money(Revenue) : "—")</strong></div>
                            <div><span>Item cost</span><strong>@(InputsValid ? Money(Cost) : "—")</strong></div>
                            <div><span>Gross profit</span><strong>@(InputsValid ? Money(Revenue - Cost) : "—")</strong></div>
                        </section>
                        @if (TooManyLines) { <p class="error-banner" role="alert">A sale can contain at most @Rules.MaxSaleLines different items. Save separate sales.</p> }
                        <button type="submit" class="button primary block" disabled="@(Saving || (InputsValid && TotalItems == 0))">@(Saving ? "Recording…" : "Record sale")</button>
                    </div>
                </section>
            </div>
        }
        else
        {
            <div class="card empty"><h2>Add your first product</h2><p>Set a selling price to start recording sales.</p><a class="button primary" href="/items/new">Add item</a></div>
        }
    </form>
    <AppNotification Message="@message" /><ErrorBanner Message="@Error" />

    <section id="sales-history" class="section sales-history">
        <div class="section-heading"><h2>Recent sales</h2><a href="/sales/history">View all</a></div>
        @if (Store.Sales.Any())
        {
            <div class="stack">
                @foreach (var sale in Store.Sales.OrderByDescending(x => x.SaleDate).ThenByDescending(x => x.CreatedAt).ThenByDescending(x => x.Id).Take(5))
                {
                    <a class="card list-card sale-history-link" href="@($"/sales/{sale.Id}")" aria-label="@($"View sale of {Quantity(sale.TotalItems)} items for {Money(sale.TotalRevenueCentavos)}")">
                        <span class="list-icon"><Icon Name="receipt" /></span>
                        <div class="list-main"><strong>@Quantity(sale.TotalItems) @(sale.TotalItems == 1 ? "item" : "items")</strong><small>@FriendlyDate(sale.SaleDate, Today()) · @string.Join(", ", sale.Lines.Select(x => x.ItemName))</small></div>
                        <strong>@Money(sale.TotalRevenueCentavos)</strong>
                    </a>
                }
            </div>
        }
        else { <p class="basket-empty">No sales recorded yet.</p> }
    </section>
</div>
</CascadingValue>
