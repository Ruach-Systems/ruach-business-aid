@inherits LayoutComponentBase
@inject BusinessState Store
@inject NavigationManager Navigation
@implements IDisposable
<div class="app-shell">
    <aside class="side-nav">
        <a class="side-brand" href="/dashboard">
<BrandLogo Reversed="true" />
</a>
        <nav aria-label="Main navigation">@foreach (var item in links) {
<NavLink href="@item.Path">
<Icon Name="@item.Icon" />@item.Label</NavLink> }
</nav>
        @if (Store.User?.IsDemo != true) { <a class="button workspace-switch" href="/businesses">Switch business</a> }
        <SyncPill />
    </aside>
    <main class="main-panel">
        <header class="mobile-header">
<a href="/dashboard" class="mobile-brand">
<BrandLogo Reversed="true" />
</a>
<SyncPill />
</header>
        <div class="workspace-context"><strong>@Store.Data.Business?.Name</strong><span>Separate business workspace</span>@if (Store.User?.IsDemo != true) { <a href="/businesses">Switch business</a> }</div>
        <SyncReview />
        @Body
    </main>
    <nav class="bottom-nav" aria-label="Mobile navigation">
        <NavLink href="/dashboard">
<Icon Name="calendar" />
<span>Today</span>
</NavLink>
<NavLink href="/business-overview">
<Icon Name="chart" />
<span>Analytics</span>
</NavLink>
<NavLink href="/sales">
<Icon Name="cart" />
<span>Sales</span>
</NavLink>
<NavLink href="/items">
<Icon Name="cube" />
<span>Items</span>
</NavLink>
<NavLink href="/more" class="@(MoreActive ? "active" : null)">
<Icon Name="more" />
<span>More</span>
</NavLink>
    </nav>
</div>
@code {
    private bool MoreActive => new[] { "/expenses", "/reports", "/settings" }.Any(p => new Uri(Navigation.Uri).AbsolutePath.StartsWith(p, StringComparison.OrdinalIgnoreCase));
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private readonly (string Path, string Label, string Icon)[] links = [("/dashboard", "Today", "calendar"), ("/business-overview", "Analytics", "chart"), ("/sales", "Sales", "cart"), ("/items", "Items", "cube"), ("/expenses", "Expenses", "receipt"), ("/reports", "Reports", "report"), ("/settings", "Settings", "settings")];
}
